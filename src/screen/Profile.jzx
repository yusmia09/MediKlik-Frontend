import React, { useEffect, useState } from "react";
import Layout from "../components/Layout";
import axios from "axios";
import { useNavigate } from "react-router-dom";

const ProfilePage = () => {
  const [user, setUser] = useState(null);
  const navigate = useNavigate();
  const token = localStorage.getItem("token");

  useEffect(() => {
    if (!token) {
      alert("Silahkan login terlebih dahulu!");
      navigate("/login");
      return;
    }

    axios
      .get("http://localhost:5000/api/users/me", {
        headers: { Authorization: `Bearer ${token}` },
      })
      .then((res) => setUser(res.data))
      .catch((err) => {
        console.error(err);
        alert("Gagal mengambil data user!");
      });
  }, [token, navigate]);

  if (!user) {
    return (
      <Layout>
        <div className="flex justify-center items-center h-screen text-cyan-600 animate-pulse">
          Memuat data profile...
        </div>
      </Layout>
    );
  }

  return (
    <Layout>
      <div className="max-w-3xl mx-auto px-6 py-16">
        <h1 className="text-3xl font-bold text-cyan-600 mb-8 text-center">Profile Saya</h1>
        <div className="bg-white shadow rounded-xl p-6 flex flex-col gap-4">
          <div>
            <span className="font-semibold">Username: </span> {user.username}
          </div>
          <div>
            <span className="font-semibold">Email: </span> {user.email}
          </div>
          <div>
            <span className="font-semibold">Tanggal Lahir: </span> {new Date(user.dateOfBirth).toLocaleDateString()}
          </div>
          <div>
            <span className="font-semibold">Jenis Kelamin: </span> {user.gender}
          </div>
          <div>
            <span className="font-semibold">Alamat: </span> {user.address}
          </div>
          <div>
            <span className="font-semibold">Kota: </span> {user.city}
          </div>
          <div>
            <span className="font-semibold">Role: </span> {user.role}
          </div>
        </div>
      </div>
    </Layout>
  );
};

export default ProfilePage;
